MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=kube-resource-fcst
MYSQL_USER=kube-resource-fcst
MYSQL_PASSWORD=replace-with-a-strong-password
KUBE_RESOURCE_FCST_JWT_SECRET=replace-with-at-least-32-random-characters

KUBE_RESOURCE_FCST_SERVER_PORT=10000
KUBE_RESOURCE_FCST_JOB_WORKERS=10
KUBE_RESOURCE_FCST_JOB_POLL_INTERVAL=5s
KUBE_RESOURCE_FCST_VERSION=dev

# Optional prebuilt images. Defaults build locally from this repository.
# KUBE_RESOURCE_FCST_IMAGE=registry.example.com/kube-resource-fcst:latest
