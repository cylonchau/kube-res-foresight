MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=kube-resource-fcst
MYSQL_USER=kube-resource-fcst
MYSQL_PASSWORD=replace-with-a-strong-password
KUBE_RESOURCE_FCST_JWT_SECRET=replace-with-at-least-32-random-characters

# Domains are configured in Cloudflare and are kept here for documentation.
KUBE_RESOURCE_FCST_DOMAIN=kube-resource-fcst.example.com

# Bind locally when Cloudflare Tunnel runs on the same host. Change to 0.0.0.0
# only when an external reverse proxy needs to reach these ports.
KUBE_RESOURCE_FCST_SERVER_BIND=127.0.0.1
KUBE_RESOURCE_FCST_SERVER_PORT=10000

KUBE_RESOURCE_FCST_JOB_WORKERS=10
KUBE_RESOURCE_FCST_JOB_POLL_INTERVAL=5s
KUBE_RESOURCE_FCST_VERSION=latest
TZ=UTC

# Optional registry images. Remove these comments to avoid local builds.
# KUBE_RESOURCE_FCST_IMAGE=registry.example.com/kube-resource-fcst:latest
