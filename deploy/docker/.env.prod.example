MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=kubeforecast
MYSQL_USER=kubeforecast
MYSQL_PASSWORD=replace-with-a-strong-password
KUBEFORECAST_JWT_SECRET=replace-with-at-least-32-random-characters

# Domains are configured in Cloudflare and are kept here for documentation.
KUBEFORECAST_DOMAIN=kubeforecast.example.com

# Bind locally when Cloudflare Tunnel runs on the same host. Change to 0.0.0.0
# only when an external reverse proxy needs to reach these ports.
KUBEFORECAST_SERVER_BIND=127.0.0.1
KUBEFORECAST_SERVER_PORT=10000

KUBEFORECAST_JOB_WORKERS=10
KUBEFORECAST_JOB_POLL_INTERVAL=5s
KUBEFORECAST_VERSION=latest
TZ=UTC

# Optional registry images. Remove these comments to avoid local builds.
# KUBEFORECAST_SERVER_IMAGE=registry.example.com/kubeforecast-server:latest
# KUBEFORECAST_JOB_IMAGE=registry.example.com/kubeforecast-job:latest
